# ── Secrets (NEVER commit real env files; only *.env.example) ──────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env
!*.env.example

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / Vite ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
.vite/
*.local

# ── Demo cache artifacts (regenerated by the cache warmer) ─────────────────
backend/app/cache/*.json

# ── Logs / coverage ────────────────────────────────────────────────────────
logs/
*.log
coverage/
.nyc_output/

# ── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.vercel
.env*.local
