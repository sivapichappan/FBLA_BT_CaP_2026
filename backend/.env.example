# ── LocalLens v2 backend environment (TEMPLATE) ────────────────────────────
# Copy this file to `backend/.env` and fill in real values. NEVER commit .env.
# Phase 0 needs ONLY DATABASE_URL. Google + LLM keys are used from Phase 1/2.

# PostgreSQL connection string (Supabase → Settings → Database → Connection string).
# Use the transaction-pooler URI. SSL is required and is added automatically if absent.
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Secret used to sign JWT access tokens. Generate a long random string:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Google Maps Platform key with Places API + Geocoding API enabled (server-side use).
GOOGLE_MAPS_API_KEY=

# Google Sign-In OAuth client id (the SAME value the frontend uses). The backend
# verifies that every Google ID token was minted for THIS client id, so a token
# issued for another app can't be replayed against us. Leave blank to disable
# the /auth/google route. Not a secret — it's the public client id, not the
# client secret (this flow never uses the secret).
GOOGLE_OAUTH_CLIENT_ID=

# LLM provider — any OpenAI-compatible endpoint. Configured here for GOOGLE AI
# STUDIO (Gemini), which exposes an OpenAI-compatible API. The LLM_API_KEY is the
# Gemini key (https://aistudio.google.com/apikey) — separate from GOOGLE_MAPS_API_KEY.
# To use Groq instead:   LLM_BASE_URL=https://api.groq.com/openai/v1
#                        LLM_INTENT_MODEL=llama-3.1-8b-instant  LLM_REPLY_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_INTENT_MODEL=gemini-2.5-flash-lite
LLM_REPLY_MODEL=gemini-2.5-flash
LLM_CLASSIFY_MODEL=gemini-2.5-flash

# Master switch for the live-API path. Set to false to force the deterministic /
# cached fallback (used to rehearse a network-free demo). Accepts true/false/1/0.
ONLINE=true

# Comma-separated origins allowed by CORS (the Vite dev server, etc.).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo city center (NYC) — default map/search location when the user has none.
DEMO_CITY=New York, NY
DEMO_LAT=40.7308
DEMO_LNG=-73.9973
