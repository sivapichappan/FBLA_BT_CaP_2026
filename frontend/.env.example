# ── LocalLens v2 frontend environment (TEMPLATE) ───────────────────────────
# Copy to `frontend/.env` and fill in. Only VITE_-prefixed vars reach the browser.

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Google Maps JS API key (client-side). Restrict it by HTTP referrer in the
# Google Cloud console — a browser key is always publicly visible.
VITE_GOOGLE_MAPS_API_KEY=

# Google Sign-In OAuth client id (ends in .apps.googleusercontent.com). Public
# by design — it ships in the page. Create it under the SAME Google Cloud
# project as the Maps key, and add your origins to "Authorized JavaScript
# origins" (e.g. http://localhost:5173 and your prod URL). Leave blank to hide
# the "Sign in with Google" button (the email/password form still works).
VITE_GOOGLE_CLIENT_ID=
